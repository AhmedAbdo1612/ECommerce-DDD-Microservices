{
  "openapi": "3.0.4",
  "info": {
    "title": "Baket.API",
    "version": "1.0"
  },
  "paths": {
    "/basket": {
      "post": {
        "tags": [
          "Baket.API"
        ],
        "operationId": "StoreBasket",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StoreBasketRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/basket/{userName}": {
      "get": {
        "tags": [
          "Baket.API"
        ],
        "operationId": "GetBasket",
        "parameters": [
          {
            "name": "userName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetBasketReponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Baket.API"
        ],
        "operationId": "DeleteBasket",
        "parameters": [
          {
            "name": "userName",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "GetBasketReponse": {
        "type": "object",
        "properties": {
          "cart": {
            "$ref": "#/components/schemas/ShoppingCart"
          }
        },
        "additionalProperties": false
      },
      "ShoppingCart": {
        "type": "object",
        "properties": {
          "userName": {
            "type": "string",
            "nullable": true
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShoppingCartItem"
            },
            "nullable": true
          },
          "totalPrice": {
            "type": "number",
            "format": "float",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "ShoppingCartItem": {
        "type": "object",
        "properties": {
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "number",
            "format": "float"
          },
          "productId": {
            "type": "string",
            "format": "uuid"
          },
          "productName": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "StoreBasketRequest": {
        "type": "object",
        "properties": {
          "cart": {
            "$ref": "#/components/schemas/ShoppingCart"
          }
        },
        "additionalProperties": false
      }
    }
  }
}