@page
@using Shopping.Web.Models.Ordering
@model Shopping.Web.Pages.Orders.IndexModel
@{
    ViewData["Title"] = "Orders Dashboard";
}

<!-- External Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Takwene Console Theme */
    :root {
        --console-bg: #06050c;
        --console-card: #110f22;
        --console-border: rgba(255, 255, 255, 0.05);
        --console-text: #f8fafc;
        --console-muted: #94a3b8;
        --console-accent: #a855f7;
        --console-gradient: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        --font-main: 'Plus Jakarta Sans', sans-serif;
    }

    body {
        background-color: var(--console-bg) !important;
        background-image: radial-gradient(circle at top right, rgba(168, 85, 247, 0.05) 0%, transparent 50%),
                          radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
        color: var(--console-text) !important;
        font-family: var(--font-main) !important;
    }

    .console-wrapper { padding-bottom: 5rem; }

    .btn-gradient {
        background: var(--console-gradient);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        transition: all 0.3s;
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(168, 85, 247, 0.5);
        color: white;
    }

    .btn-outline-glass {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--console-text);
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s;
    }
    .btn-outline-glass:hover {
        background: rgba(255, 255, 255, 0.05);
        color: white;
    }

    .filter-container {
        background: var(--console-card);
        border: 1px solid var(--console-border);
        border-radius: 20px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    }

    .form-control-glass, .form-select-glass {
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: var(--console-text) !important;
        border-radius: 12px;
    }
    .form-control-glass::placeholder { color: rgba(255,255,255,0.25); }

    .table-console { color: var(--console-text); }
    .table-console th {
        border-bottom: 1px solid var(--console-border);
        color: var(--console-muted);
        font-weight: 600;
        padding: 1rem;
    }
    .table-console td {
        border-bottom: 1px solid var(--console-border);
        padding: 1rem;
        vertical-align: middle;
        background: transparent !important;
        color: var(--console-text) !important;
    }
    
    .badge-status {
        border-radius: 50px;
        padding: 0.5rem 1rem;
        font-weight: 600;
        font-size: 0.8rem;
    }
    .status-draft { background: rgba(148, 163, 184, 0.1); color: #94a3b8; border: 1px solid rgba(148, 163, 184, 0.2); }
    .status-pending { background: rgba(234, 179, 8, 0.1); color: #eab308; border: 1px solid rgba(234, 179, 8, 0.2); }
    .status-completed { background: rgba(34, 197, 94, 0.1); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.2); }
    .status-cancelled { background: rgba(239, 68, 68, 0.1); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); }
</style>

<div class="console-wrapper container-fluid px-4 px-lg-5 pt-5">
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert text-success text-center my-4" style="background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); color: #4ade80;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert text-danger text-center my-4" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert text-danger text-center my-4" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        </div>
    }

    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h1 class="fw-bolder m-0" style="font-size: 2.5rem; letter-spacing: -1px;">Orders Console</h1>
            <p class="text-muted m-0 mt-2" style="font-size: 1.1rem;">Manage orders and customer purchases.</p>
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-container mb-4">
        <form method="get" class="row g-3 align-items-center">
            <input type="hidden" name="PageNumber" value="1" />
            <div class="col-md-5">
                <input type="text" name="SearchQuery" asp-for="SearchQuery" class="form-control form-control-glass" placeholder="Search Order Name or ID...">
            </div>
            <div class="col-md-4">
                <select name="Status" asp-for="Status" class="form-select form-select-glass">
                    <option value="">All Statuses</option>
                    <option value="1">Draft</option>
                    <option value="2">Pending</option>
                    <option value="3">Completed</option>
                    <option value="4">Cancelled</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-gradient w-100"><i class="bi bi-search me-2"></i> Search</button>
            </div>
        </form>
    </div>

    @if (Model.OrderList != null && Model.OrderList.Any())
    {
        <div class="table-responsive" style="background: var(--console-card); border-radius: 20px; border: 1px solid var(--console-border);">
            <table class="table table-console mb-0">
                <thead>
                    <tr>
                        <th>Order ID</th>
                        <th>Order Name</th>
                        <th>Customer</th>
                        <th>Total Items</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.OrderList)
                    {
                        <tr>
                            <td class="font-monospace text-muted">@order.Id.ToString().Substring(0,8)</td>
                            <td class="fw-bold">@order.OrderName</td>
                            <td>
                                @order.ShippingAddress?.FirstName @order.ShippingAddress?.LastName<br/>
                                <small class="text-muted">@order.ShippingAddress?.EmailAddress</small>
                            </td>
                            <td>@(order.OrderItems?.Sum(i => i.Quantity) ?? 0)</td>
                            <td>
                                @if (order.Status == OrderStatus.Draft) { <span class="badge badge-status status-draft">Draft</span> }
                                else if (order.Status == OrderStatus.Pending) { <span class="badge badge-status status-pending">Pending</span> }
                                else if (order.Status == OrderStatus.Completed) { <span class="badge badge-status status-completed">Completed</span> }
                                else if (order.Status == OrderStatus.Cancelled) { <span class="badge badge-status status-cancelled">Cancelled</span> }
                            </td>
                            <td class="text-end">
                                <a asp-page="./Detail" asp-route-id="@order.Id" class="btn btn-sm btn-outline-glass me-2">Details</a>
                                
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                                {
                                    <form method="post" asp-page-handler="DeleteOrder" class="d-inline" onsubmit="return confirm('Delete this order?');">
                                        <input type="hidden" name="orderId" value="@order.Id" />
                                        <button type="submit" class="btn btn-sm" style="color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 50px; background: rgba(239, 68, 68, 0.05);">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-4 d-flex justify-content-center">
            @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
            {
                <nav>
                    <ul class="pagination gap-2">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                            <a class="btn btn-outline-glass" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)">Prev</a>
                        </li>
                        <li class="page-item disabled">
                            <span class="btn btn-glass border-0 text-white">Page @Model.PageNumber</span>
                        </li>
                        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                            <a class="btn btn-outline-glass" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)">Next</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5" style="background: var(--console-card); border: 1px solid var(--console-border); border-radius: 20px;">
            <i class="bi bi-inbox fs-1 d-block mb-3" style="color: var(--console-muted); opacity: 0.5;"></i>
            <h4 class="fw-bold text-white">No orders found.</h4>
            <p class="text-muted">No orders match your criteria.</p>
        </div>
    }
</div>
