@using Shopping.Web.Services
@using Refit
@inject IBasketService BasketService
@{
    int cartCount = 0;
    string? userName = User.Identity?.Name;

    if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(userName))
    {
        try
        {
            var basketResponse = await BasketService.GetBasket(userName);
            if (basketResponse?.Cart?.Items != null)
            {
                cartCount = basketResponse.Cart.Items.Sum(i => i.Quantity);
            }
        }
        catch (ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.NotFound)
        {
            cartCount = 0;
        }
        catch (Exception)
        {
            cartCount = 0;
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shopping.Web</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Shopping.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow" style="background-color: #06050c; border-color: rgba(255, 255, 255, 0.05) !important;">
            <div class="container-fluid px-4 py-2">
                <a class="navbar-brand fw-bold fs-4" style="color: #f8fafc;" asp-area="" asp-page="/Index">Instashop</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex">
                    <!-- Centered Links -->
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 fw-semibold">
                        <li class="nav-item px-2">
                            <a class="nav-link" style="color: #94a3b8;" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                        {
                            <li class="nav-item px-2">
                                <a class="nav-link" style="color: #94a3b8;" asp-area="" asp-page="/CreateProduct">Create Product</a>
                            </li>
                        }
                        <li class="nav-item px-2">
                            <a class="nav-link" style="color: #94a3b8;" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item px-2">
                                <a class="nav-link" style="color: #94a3b8;" asp-area="" asp-page="/Orders/Index">Orders</a>
                            </li>
                        }
                    </ul>
                    <!-- Far-Right Icons -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <a asp-page="/Cart" class="nav-link position-relative" style="color: #f8fafc;">
                                    <i class="bi bi-cart3 fs-5"></i>
                                    <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill" style="background: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%); font-size: 0.65rem; margin-top: 5px;">
                                        @cartCount
                                        <span class="visually-hidden">items in cart</span>
                                    </span>
                                </a>
                            </li>
                            <li class="nav-item text-white me-3 d-flex align-items-center">
                                <span class="badge bg-secondary me-2">@(User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.Role)?.Value)</span> @User.Identity.Name
                            </li>
                            <li class="nav-item">
                                <a asp-page="/Logout" class="nav-link" style="color: #f8fafc;" title="Logout">
                                    <i class="bi bi-box-arrow-right fs-5"></i>
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-page="/Login" class="nav-link" style="color: #f8fafc;">
                                    Login / Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Shopping.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
