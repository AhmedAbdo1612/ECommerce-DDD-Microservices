@page "{id:Guid}"
@model Shopping.Web.Pages.ProductDetailModel
@{
    ViewData["Title"] = Model.Product?.Name ?? "Product Details";
}

<!-- External Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    :root {
        --color-bg-light: #f1f5f9; /* Light grey-blue */
        --color-bg-white: #ffffff;
        --color-text-dark: #0f172a;
        --color-text-muted: #64748b;
        --color-primary-darkblue: #1e3a8a; /* Dark blue button */
        --color-primary-hover: #1e40af;
        --font-main: 'Plus Jakarta Sans', sans-serif;
    }

    body {
        /* Remove the dark theme override for this specific page if possible, 
           or forcefully override it here for the light theme */
        background-color: var(--color-bg-light) !important;
        background-image: none !important;
        color: var(--color-text-dark) !important;
        font-family: var(--font-main) !important;
    }

    /* Light Grey-Blue Banner Container */
    .product-banner {
        background-color: var(--color-bg-light);
        padding: 3rem 0;
        min-height: calc(100vh - 80px);
    }

    .content-card {
        background: var(--color-bg-white);
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        padding: 2.5rem;
    }

    /* Typography */
    .product-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--color-text-dark);
        line-height: 1.2;
    }
    .product-price {
        font-size: 2rem;
        font-weight: 700;
        color: var(--color-primary-darkblue);
    }

    /* Left-side Specifications Table */
    .specs-table {
        margin-top: 2rem;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        overflow: hidden;
    }
    .specs-table th {
        background: #f8fafc;
        color: var(--color-text-muted);
        font-weight: 600;
        width: 40%;
        padding: 1rem;
        border-bottom: 1px solid #e2e8f0;
    }
    .specs-table td {
        padding: 1rem;
        border-bottom: 1px solid #e2e8f0;
        color: var(--color-text-dark);
        font-weight: 500;
    }
    .specs-table tr:last-child th,
    .specs-table tr:last-child td {
        border-bottom: none;
    }

    /* Dark Blue Add to Basket Button */
    .btn-darkblue {
        background-color: var(--color-primary-darkblue);
        color: white;
        font-weight: 600;
        border-radius: 8px;
        padding: 0.8rem 2rem;
        transition: all 0.2s ease;
        border: none;
    }
    .btn-darkblue:hover {
        background-color: var(--color-primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3);
    }

    .qty-input {
        width: 80px;
        text-align: center;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        font-weight: 600;
        color: var(--color-text-dark);
    }

    /* Right-side Image Gallery with Vertical Thumbnails */
    .gallery-container {
        display: flex;
        gap: 1.5rem;
        height: 100%;
    }
    .vertical-thumbnails {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100px;
        max-height: 500px;
        overflow-y: auto;
    }
    /* Hide scrollbar for thumbnails */
    .vertical-thumbnails::-webkit-scrollbar { width: 0px; }
    
    .thumbnail-item {
        width: 100%;
        height: 100px;
        border: 2px solid transparent;
        border-radius: 12px;
        overflow: hidden;
        cursor: pointer;
        transition: all 0.2s ease;
        background: #f8fafc;
    }
    .thumbnail-item:hover, .thumbnail-item.active {
        border-color: var(--color-primary-darkblue);
    }
    .thumbnail-item img {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .main-image-view {
        flex-grow: 1;
        background: #f8fafc;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
        height: 500px;
    }
    .main-image-view img {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        transition: opacity 0.3s ease;
    }

    /* Breadcrumbs */
    .breadcrumb-link {
        color: var(--color-text-muted);
        text-decoration: none;
        font-weight: 500;
    }
    .breadcrumb-link:hover {
        color: var(--color-primary-darkblue);
    }
</style>

<div class="product-banner">
    <div class="container">
        
        <!-- Breadcrumb -->
        <div class="mb-4">
            <a asp-page="/Index" class="breadcrumb-link"><i class="bi bi-house-door me-1"></i>Home</a>
            <span class="mx-2 text-muted">/</span>
            <span class="text-dark fw-semibold">@(Model.Product?.Name ?? "Details")</span>
        </div>

        @if (TempData["CartMessage"] != null)
        {
            <div class="alert alert-success d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                <div>@TempData["CartMessage"]</div>
            </div>
        }

        @if (Model.Product != null)
        {
            <div class="content-card">
                <div class="row g-5">
                    
                    <!-- LEFT SIDE: Product Info & Specifications -->
                    <div class="col-lg-6 d-flex flex-column">
                        <div class="mb-2">
                            @if (Model.Product.Category != null && Model.Product.Category.Any())
                            {
                                <span class="badge bg-secondary rounded-pill px-3 py-2 fw-semibold me-2">
                                    @Model.Product.Category.FirstOrDefault()
                                </span>
                            }
                            <span class="text-warning fs-5">
                                <i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-fill"></i><i class="bi bi-star-half"></i>
                            </span>
                            <span class="text-muted ms-2">(128 reviews)</span>
                        </div>

                        <h1 class="product-title mb-3">@Model.Product.Name</h1>
                        <div class="product-price mb-4">@Model.Product.Price.ToString("C")</div>

                        <p class="text-muted" style="font-size: 1.1rem; line-height: 1.6;">
                            @Model.Product.Description
                        </p>

                        <!-- Specifications -->
                        <div class="specs-table mt-4 mb-5">
                            <table class="table mb-0">
                                <tbody>
                                    <tr>
                                        <th>Brand</th>
                                        <td>Instashop Exclusive</td>
                                    </tr>
                                    <tr>
                                        <th>Availability</th>
                                        <td><span class="text-success"><i class="bi bi-check2-circle me-1"></i>In Stock</span></td>
                                    </tr>
                                    <tr>
                                        <th>SKU</th>
                                        <td class="font-monospace text-muted">@Model.Product.Id.ToString().Substring(0,8).ToUpper()</td>
                                    </tr>
                                    <tr>
                                        <th>Shipping</th>
                                        <td>Free Delivery</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Add to Basket Action -->
                        <div class="mt-auto pt-4 border-top">
                            <form method="post" asp-page-handler="AddToBasket" class="d-flex gap-3 align-items-center">
                                <input type="hidden" name="productId" value="@Model.Product.Id" />
                                
                                <div>
                                    <input type="number" asp-for="Quantity" class="form-control form-control-lg qty-input" min="1" max="99" value="1" />
                                </div>
                                
                                <button type="submit" class="btn btn-darkblue btn-lg flex-grow-1 d-flex align-items-center justify-content-center gap-2">
                                    <i class="bi bi-cart-plus fs-5"></i> Add to Basket
                                </button>
                            </form>
                        </div>
                    </div>

                    <!-- RIGHT SIDE: Vertical Image Gallery -->
                    <div class="col-lg-6">
                        <div class="gallery-container">
                            
                            <!-- Vertical Thumbnails -->
                            <div class="vertical-thumbnails">
                                @if (Model.Product.Images != null && Model.Product.Images.Any())
                                {
                                    var index = 0;
                                    foreach (var img in Model.Product.Images.OrderByDescending(x=>x.IsPrimary))
                                    {
                                        <div class="thumbnail-item @(index == 0 ? "active" : "")" onclick="changeMainImage('@img.Url', this)">
                                            <img src="@img.Url" alt="Thumbnail @index" onerror="this.onerror=null;this.src='https://via.placeholder.com/150?text=No+Img';">
                                        </div>
                                        index++;
                                    }
                                }
                                else
                                {
                                    <div class="thumbnail-item active">
                                        <img src="https://via.placeholder.com/150?text=No+Img" alt="Thumbnail">
                                    </div>
                                }
                            </div>

                            <!-- Main Display -->
                            <div class="main-image-view">
                                @{
                                    var mainImgUrl = (Model.Product.Images != null && Model.Product.Images.Any()) 
                                        ? Model.Product.Images.OrderByDescending(x=>x.IsPrimary).First().Url 
                                        : "https://via.placeholder.com/600x400?text=No+Image";
                                }
                                <img id="mainProductImage" src="@mainImgUrl" alt="@Model.Product.Name" onerror="this.onerror=null;this.src='https://via.placeholder.com/600x400?text=No+Image';">
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function changeMainImage(url, element) {
            // Update Main Image
            const mainImg = document.getElementById('mainProductImage');
            mainImg.style.opacity = 0.5;
            setTimeout(() => {
                mainImg.src = url;
                mainImg.style.opacity = 1;
            }, 150);

            // Update Active State on Thumbnails
            const thumbnails = document.querySelectorAll('.thumbnail-item');
            thumbnails.forEach(t => t.classList.remove('active'));
            element.classList.add('active');
        }
    </script>
}
