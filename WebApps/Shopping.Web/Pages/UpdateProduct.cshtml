@page "{id:Guid}"
@model Shopping.Web.Pages.UpdateProductModel
@{
    ViewData["Title"] = "Update Product";
}

<!-- External Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Takwene Music Inspired Luxury Tech Theme */
    :root {
        --color-bg-canvas: #06050c;
        --color-glass: rgba(255, 255, 255, 0.03);
        --color-glass-border: rgba(255, 255, 255, 0.05);
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
        --shadow-glow: 0 10px 40px -10px rgba(139, 92, 246, 0.3);
        --font-main: 'Plus Jakarta Sans', sans-serif;
    }

    body {
        background-color: var(--color-bg-canvas) !important;
        background-image: radial-gradient(circle at 50% 0%, rgba(139, 92, 246, 0.1) 0%, transparent 60%);
        color: var(--color-text-main) !important;
        font-family: var(--font-main) !important;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
    }

    .glass-card {
        background: var(--color-glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--color-glass-border);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transition: box-shadow 0.4s ease;
    }
    
    .glass-card:hover {
        box-shadow: var(--shadow-glow);
    }

    /* Form Controls */
    .form-control, .form-select {
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: var(--color-text-main) !important;
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        transition: all 0.3s ease;
        font-family: var(--font-main);
    }
    .form-control:focus, .form-select:focus {
        background: rgba(255, 255, 255, 0.05) !important;
        border-color: #8b5cf6 !important;
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15) !important;
        outline: none;
    }
    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }
    
    .form-label {
        font-weight: 600;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
        color: #cbd5e1;
        margin-bottom: 0.5rem;
    }

    /* Buttons */
    .btn-gradient {
        background: var(--gradient-primary);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.5);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
    }

    .btn-outline-glass {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--color-text-main);
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-glass:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.4);
        color: white;
    }

    /* Existing Images Gallery */
    .img-card {
        background: rgba(0, 0, 0, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        overflow: hidden;
        transition: all 0.3s ease;
    }
    .img-card:hover {
        border-color: rgba(139, 92, 246, 0.5);
        transform: translateY(-4px);
    }
    .img-preview {
        height: 120px;
        background: radial-gradient(circle, rgba(255,255,255,0.05), transparent);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
    }
    .img-preview img {
        max-height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 4px 6px rgba(0,0,0,0.4));
    }
    .img-actions {
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        padding: 0.75rem;
    }
    
    /* Custom Checkbox & Radio */
    .form-check-input {
        background-color: rgba(255,255,255,0.1);
        border-color: rgba(255,255,255,0.2);
    }
    .form-check-input:checked {
        background-color: #8b5cf6;
        border-color: #8b5cf6;
    }

    /* Animation */
    .fade-up {
        animation: fadeUpAnim 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    @@keyframes fadeUpAnim {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container mt-5 mb-5 fade-up">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="glass-card p-4 p-md-5">
                <div class="d-flex align-items-center mb-5">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.3);">
                        <i class="bi bi-pencil-square fs-4" style="color: #a78bfa;"></i>
                    </div>
                    <h2 class="fw-bolder m-0" style="letter-spacing: -0.5px;">Update Product</h2>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert glass-card border-danger text-danger mb-4 d-flex align-items-center" style="background: rgba(239, 68, 68, 0.1);">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i> @Model.ErrorMessage
                    </div>
                }

                <form method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="Product.Id" />
                    
                    <div class="mb-4">
                        <label asp-for="Product.Name" class="form-label">Product Name</label>
                        <input asp-for="Product.Name" class="form-control" required />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Product.Category" class="form-label">Category</label>
                        <input asp-for="Product.Category" class="form-control" placeholder="e.g. Electronics, Computers, Laptops" required />
                        <div class="form-text mt-2" style="color: var(--color-text-muted); font-size: 0.8rem;">Separate multiple categories with commas.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Product.Description" class="form-label">Description</label>
                        <textarea asp-for="Product.Description" class="form-control" rows="5" required></textarea>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Product.Price" class="form-label">Price ($)</label>
                        <div class="input-group">
                            <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #94a3b8;"><i class="bi bi-currency-dollar"></i></span>
                            <input asp-for="Product.Price" type="number" step="0.01" class="form-control border-start-0 ps-0" required />
                        </div>
                    </div>

                    @if (Model.Product.ExistingImages != null && Model.Product.ExistingImages.Any())
                    {
                        <div class="mb-5">
                            <label class="form-label mb-3">Manage Existing Images</label>
                            <div class="row g-3">
                                @foreach (var img in Model.Product.ExistingImages)
                                {
                                    var uniqueId = Guid.NewGuid().ToString("N");
                                    <div class="col-6 col-sm-4">
                                        <div class="img-card h-100">
                                            <div class="img-preview">
                                                <img src="@img.Url" alt="Product Image" />
                                            </div>
                                            <div class="img-actions">
                                                <div class="form-check mb-2">
                                                    <input class="form-check-input" type="radio" name="PrimaryImageUrl" value="@img.Url" id="primary_@uniqueId" @(img.IsPrimary ? "checked" : "")>
                                                    <label class="form-check-label small" for="primary_@uniqueId" style="color: #a78bfa;">Primary</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="ImagesToDelete" value="@img.Url" id="delete_@uniqueId">
                                                    <label class="form-check-label small text-danger" for="delete_@uniqueId">Delete</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    <div class="mb-5">
                        <label asp-for="NewFiles" class="form-label">Upload New Images (Optional)</label>
                        <input asp-for="NewFiles" type="file" class="form-control" multiple accept="image/*" />
                    </div>

                    <div class="d-flex flex-column flex-sm-row gap-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                        <button type="submit" class="btn btn-gradient btn-lg px-5 py-3 w-100 w-sm-auto">
                            <i class="bi bi-check2-circle me-2"></i> Save Changes
                        </button>
                        <a asp-page="/Index" class="btn btn-outline-glass btn-lg px-5 py-3 w-100 w-sm-auto text-center text-decoration-none">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
