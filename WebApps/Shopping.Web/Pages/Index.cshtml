@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<!-- Include Bootstrap Icons CDN (Optional if already in _Layout.cshtml) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger text-center my-4 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
    </div>
}

<!-- Hero Carousel Banner -->
<div id="heroCarousel" class="carousel slide mb-5 shadow-lg rounded overflow-hidden" data-bs-ride="carousel">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
    </div>
    <div class="carousel-inner">
        <!-- Banner 1 -->
        <div class="carousel-item active">
            <img src="~/images/banner1.jpg" class="d-block w-100" alt="Premium Tech and Lifestyle" style="height: 500px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 p-4 rounded text-start" style="backdrop-filter: blur(8px);">
                <h1 class="display-4 fw-bold text-white mb-3">Welcome to Instashop</h1>
                <p class="lead text-light mb-4">Discover the latest in premium gadgets, tech, and lifestyle accessories. Engineered for perfection.</p>
                <a href="#featured-products" class="btn btn-primary btn-lg px-5 py-2 rounded-pill shadow">Shop Now</a>
            </div>
        </div>
        <!-- Banner 2 -->
        <div class="carousel-item">
            <img src="~/images/banner2.jpg" class="d-block w-100" alt="Minimalist Gadget Setup" style="height: 500px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-75 p-4 rounded text-end" style="backdrop-filter: blur(8px);">
                <h2 class="display-4 fw-bold text-white mb-3">Elevate Your Setup</h2>
                <p class="lead text-light mb-4">Experience minimalist design and cutting-edge performance. Exclusive collections inside.</p>
                <a href="#featured-products" class="btn btn-outline-light btn-lg px-5 py-2 rounded-pill shadow">Explore Collection</a>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Next</span>
    </button>
</div>

<!-- Features Section -->
<div class="container mb-5 mt-5">
    <div class="row text-center g-4">
        <div class="col-md-4">
            <div class="p-5 bg-white border border-light rounded-4 shadow-sm h-100 feature-card">
                <i class="bi bi-truck fs-1 text-primary mb-3"></i>
                <h5 class="fw-bold mt-2">Free Shipping</h5>
                <p class="text-muted mb-0">On all orders over $100 worldwide.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-5 bg-white border border-light rounded-4 shadow-sm h-100 feature-card">
                <i class="bi bi-shield-check fs-1 text-success mb-3"></i>
                <h5 class="fw-bold mt-2">Secure Payments</h5>
                <p class="text-muted mb-0">100% secure checkout and data protection.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-5 bg-white border border-light rounded-4 shadow-sm h-100 feature-card">
                <i class="bi bi-arrow-return-left fs-1 text-warning mb-3"></i>
                <h5 class="fw-bold mt-2">Easy Returns</h5>
                <p class="text-muted mb-0">30-day seamless money-back guarantee.</p>
            </div>
        </div>
    </div>
</div>

<!-- Featured Products Section -->
<div id="featured-products" class="container mb-5 pt-3">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
        <h2 class="fw-bold m-0"><i class="bi bi-stars text-warning me-2"></i>Featured Products</h2>
    </div>

    @if (Model.ProductList != null && Model.ProductList.Any())
    {
        <div class="row row-cols-1 row-cols-md-4 g-4">
            @foreach (var product in Model.ProductList)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border border-light rounded-4 product-card overflow-hidden">
                        
                        <!-- Image with Fallback -->
                        <div class="bg-light d-flex align-items-center justify-content-center p-4" style="height: 220px;">
                            <img src="@(string.IsNullOrEmpty(product.ImageFile) ? "https://via.placeholder.com/300x200?text=No+Image" : $"/images/products/{product.ImageFile}")" 
                                 class="card-img-top img-fluid mix-blend-multiply" 
                                 alt="@product.Name" 
                                 onerror="this.onerror=null;this.src='https://via.placeholder.com/300x200?text=No+Image';"
                                 style="max-height: 180px; object-fit: contain;">
                        </div>

                        <div class="card-body d-flex flex-column">
                            <div class="mb-2">
                                @if (product.Category != null && product.Category.Any())
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-3 py-2 small fw-semibold">
                                        @product.Category.FirstOrDefault()
                                    </span>
                                }
                            </div>
                            <h5 class="card-title fw-bold text-truncate mt-2" title="@product.Name">@product.Name</h5>
                            
                            <p class="card-text text-muted small flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @product.Description
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top border-light">
                                <span class="fs-4 fw-bolder text-dark">@product.Price.ToString("C")</span>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="card-footer bg-white border-0 pt-0 pb-4 px-4">
                            <div class="d-grid gap-2">
                                <a asp-page="/ProductDetail" asp-route-id="@product.Id" class="btn btn-outline-dark rounded-pill fw-semibold">
                                    <i class="bi bi-eye me-1"></i> View Details
                                </a>
                                <form method="post" asp-page-handler="AddToBasket" class="d-grid m-0">
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-primary rounded-pill fw-semibold shadow-sm">
                                        <i class="bi bi-cart-plus me-1"></i> Add to Basket
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <!-- Empty State -->
        <div class="text-center py-5 text-muted bg-light rounded-4 border border-light">
            <i class="bi bi-box-seam fs-1 d-block mb-3 text-secondary"></i>
            <h4 class="fw-bold">No products found.</h4>
            <p>Our shelves are currently empty. Please check back later.</p>
        </div>
    }
</div>

<!-- Custom CSS to fulfill aesthetics -->
<style>
    .product-card {
        transition: transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.12) !important;
    }
    .feature-card {
        transition: transform 0.2s ease;
    }
    .feature-card:hover {
        transform: translateY(-4px);
    }
    .mix-blend-multiply {
        mix-blend-mode: multiply;
    }
</style>
