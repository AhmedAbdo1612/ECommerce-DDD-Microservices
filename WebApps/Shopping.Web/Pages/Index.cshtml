@page
@model IndexModel
@{
    ViewData["Title"] = "Instashop Console";
}

<!-- External Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Takwene Music Inspired Console Theme */
    :root {
        --console-bg: #06050c;
        --console-card: #110f22;
        --console-border: rgba(255, 255, 255, 0.05);
        --console-text: #f8fafc;
        --console-muted: #94a3b8;
        --console-accent: #a855f7;
        --console-gradient: linear-gradient(135deg, #a855f7 0%, #3b82f6 100%);
        --font-main: 'Plus Jakarta Sans', sans-serif;
    }

    body {
        background-color: var(--console-bg) !important;
        background-image: radial-gradient(circle at top right, rgba(168, 85, 247, 0.05) 0%, transparent 50%),
                          radial-gradient(circle at bottom left, rgba(59, 130, 246, 0.05) 0%, transparent 50%);
        color: var(--console-text) !important;
        font-family: var(--font-main) !important;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
    }

    main { padding: 0 !important; }

    .console-wrapper {
        min-height: 100vh;
        padding-bottom: 5rem;
    }

    /* Header Actions */
    .btn-gradient {
        background: var(--console-gradient);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(168, 85, 247, 0.3);
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(168, 85, 247, 0.5);
        color: white;
    }

    .btn-outline-glass {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        color: var(--console-text);
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-glass:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.2);
        color: white;
    }
    
    .btn-outline-danger-glass {
        background: rgba(239, 68, 68, 0.05);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #ef4444;
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-danger-glass:hover {
        background: rgba(239, 68, 68, 0.15);
        border-color: rgba(239, 68, 68, 0.4);
        color: #ef4444;
    }

    /* Filter Bar Container */
    .filter-container {
        background: var(--console-card);
        border: 1px solid var(--console-border);
        border-radius: 20px;
        padding: 1.25rem 1.5rem;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
        margin-bottom: 2.5rem;
    }

    /* Forms & Inputs */
    .form-control-glass, .form-select-glass {
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.08) !important;
        color: var(--console-text) !important;
        border-radius: 12px;
        transition: all 0.3s ease;
        padding: 0.7rem 1.25rem;
    }
    .form-control-glass:focus, .form-select-glass:focus {
        background: rgba(255, 255, 255, 0.06) !important;
        border-color: var(--console-accent) !important;
        box-shadow: 0 0 0 3px rgba(168, 85, 247, 0.2) !important;
    }
    .form-control-glass::placeholder {
        color: rgba(255,255,255,0.25);
    }
    .input-group-text-glass {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-right: none;
        color: var(--console-muted);
        border-radius: 12px 0 0 12px;
    }
    .form-control-glass-group {
        border-radius: 0 12px 12px 0 !important;
        border-left: none !important;
    }
    .form-control-glass-group:focus {
        border-left: none !important;
    }
    .form-select-glass option {
        background: var(--console-bg);
        color: var(--console-text);
    }

    /* Product Cards */
    .product-card {
        background: rgba(17, 15, 34, 0.6);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--console-border);
        border-radius: 20px;
        overflow: hidden;
        transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .product-card:hover {
        transform: translateY(-8px);
        border-color: rgba(168, 85, 247, 0.3);
        box-shadow: 0 15px 35px rgba(0,0,0,0.4), 0 0 20px rgba(168, 85, 247, 0.15);
    }
    .product-img-wrapper {
        background: radial-gradient(circle at 50% 50%, rgba(255,255,255,0.03), transparent);
        height: 200px;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1.5rem;
    }
    .product-img-wrapper img {
        max-height: 100%;
        object-fit: contain;
        transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
        filter: drop-shadow(0 10px 15px rgba(0,0,0,0.4));
    }
    .product-card:hover .product-img-wrapper img {
        transform: scale(1.1) translateY(-5px);
    }
    .card-title {
        font-weight: 700;
        letter-spacing: -0.02em;
    }
    .price-gradient {
        font-weight: 800;
        font-size: 1.25rem;
        background: var(--console-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    .badge-console {
        background: rgba(168, 85, 247, 0.1);
        border: 1px solid rgba(168, 85, 247, 0.2);
        color: #d8b4fe;
        font-weight: 600;
        letter-spacing: 0.5px;
    }

    /* Pagination */
    .pagination .page-link {
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.05);
        color: var(--console-muted);
        transition: all 0.3s ease;
    }
    .pagination .page-link:hover:not(.disabled) {
        background: rgba(168, 85, 247, 0.1);
        color: #d8b4fe;
        border-color: rgba(168, 85, 247, 0.3);
    }
    .pagination .disabled .page-link {
        opacity: 0.5;
    }

    /* Modal */
    .modal-content {
        background: var(--console-card);
        border: 1px solid var(--console-border);
        box-shadow: 0 25px 50px rgba(0,0,0,0.5);
    }
    
    /* Animations */
    .fade-up {
        opacity: 0;
        transform: translateY(20px);
        animation: fadeUpAnim 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .stagger-1 { animation-delay: 0.1s; }
    .stagger-2 { animation-delay: 0.2s; }
    .stagger-3 { animation-delay: 0.3s; }
    
    @@keyframes fadeUpAnim {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="console-wrapper container-fluid px-4 px-lg-5 pt-5">
    
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert text-danger text-center my-4 fade-up" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2);" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @Model.ErrorMessage
        </div>
    }

    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end mb-4 fade-up">
        <div>
            <h1 class="fw-bolder m-0" style="font-size: 2.5rem; letter-spacing: -1px;">Product Console</h1>
            <p class="text-muted m-0 mt-2" style="font-size: 1.1rem;">Manage inventory, view analytics, and control the Takwene ecosystem.</p>
        </div>
        <div class="d-flex gap-3 mt-4 mt-md-0">
            <a asp-page="./Index" class="btn btn-outline-glass px-4 py-2 d-flex align-items-center">
                <i class="bi bi-arrow-clockwise me-2"></i> Refresh
            </a>
            <a asp-page="/CreateProduct" class="btn btn-gradient px-4 py-2 d-flex align-items-center">
                <i class="bi bi-plus-circle-fill me-2"></i> Add Product
            </a>
        </div>
    </div>

    <!-- Filter / Search Bar -->
    <div class="filter-container fade-up stagger-1">
        <form method="get" class="row g-3 align-items-center">
            <!-- Retain page number internally if searching -->
            <input type="hidden" name="PageNumber" value="1" />
            
            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text input-group-text-glass"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchQuery" asp-for="SearchQuery" class="form-control form-control-glass form-control-glass-group" placeholder="Search product name or SKU...">
                </div>
            </div>
            <div class="col-md-3">
                <select name="category" asp-for="Category" class="form-select form-select-glass">
                    <option value="">All Categories</option>
                    <option value="Electronics">Electronics</option>
                    <option value="Audio">Audio & Music</option>
                    <option value="Accessories">Accessories</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" asp-for="Status" class="form-select form-select-glass">
                    <option value="">All Statuses</option>
                    <option value="Active">Active / In Stock</option>
                    <option value="Draft">Draft</option>
                </select>
            </div>
            <div class="col-md-1 text-md-end">
                <button type="submit" class="btn btn-outline-glass w-100"><i class="bi bi-funnel"></i></button>
            </div>
        </form>
    </div>

    <!-- Data Collection -->
    @if (Model.ProductList != null && Model.ProductList.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 fade-up stagger-2">
            @foreach (var product in Model.ProductList)
            {
                <div class="col">
                    <div class="card h-100 product-card">
                        
                        <!-- Image with Fallback (Clickable) -->
                        <a asp-page="/ProductDetail" asp-route-id="@product.Id" class="text-decoration-none d-block">
                            <div class="product-img-wrapper">
                                <img src="@(product.Images == null || !product.Images.Any() || string.IsNullOrEmpty(product.Images.FirstOrDefault(x=>x.IsPrimary)?.Url) ? "https://via.placeholder.com/300x200?text=No+Image&bg=110f22&color=94a3b8" : product.Images.FirstOrDefault(x=>x.IsPrimary==true)?.Url)" 
                                     class="card-img-top img-fluid" 
                                     alt="@product.Name" 
                                     onerror="this.onerror=null;this.src='https://via.placeholder.com/300x200?text=No+Image&bg=110f22&color=94a3b8';">
                            </div>
                        </a>

                        <div class="card-body d-flex flex-column p-4 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                @if (product.Category != null && product.Category.Any())
                                {
                                    <span class="badge badge-console rounded-pill px-3 py-2 text-uppercase" style="font-size: 0.7rem;">
                                        @product.Category.FirstOrDefault()
                                    </span>
                                }
                                <span class="price-gradient">@product.Price.ToString("C")</span>
                            </div>
                            <a asp-page="/ProductDetail" asp-route-id="@product.Id" class="text-decoration-none">
                                <h5 class="card-title text-truncate mt-2 text-white" title="@product.Name">@product.Name</h5>
                            </a>
                            
                            <p class="card-text small mt-1 flex-grow-1" style="color: var(--console-muted); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                                @product.Description
                            </p>
                        </div>
                        
                        <!-- Actions -->
                        <div class="card-footer bg-transparent border-top p-3" style="border-color: rgba(255,255,255,0.05) !important;">
                            <div class="d-flex gap-2">
                                <a asp-page="/UpdateProduct" asp-route-id="@product.Id" class="btn btn-outline-glass w-100 rounded-pill py-2" style="font-size: 0.9rem;">
                                    <i class="bi bi-pencil me-1"></i> Edit
                                </a>
                                <button type="button" class="btn btn-outline-danger-glass w-100 rounded-pill py-2" style="font-size: 0.9rem;" onclick="confirmDelete('@product.Id', this.getAttribute('data-name'))" data-name="@product.Name">
                                    <i class="bi bi-trash me-1"></i> Delete
                                </button>
                            </div>
                            <form method="post" asp-page-handler="AddToBasket" class="mt-2">
                                <input type="hidden" name="productId" value="@product.Id" />
                                <button type="submit" class="btn btn-gradient w-100 rounded-pill py-2" style="font-size: 0.9rem;">
                                    <i class="bi bi-cart-plus me-1"></i> Add Basket
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination Controls -->
        <nav aria-label="Product navigation" class="mt-5 pt-3 fade-up stagger-3">
            <ul class="pagination justify-content-center gap-2">
                <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                    <a class="page-link rounded-pill px-4 py-2 border-0 fw-semibold" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber - 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-status="@Model.Status">
                        <i class="bi bi-chevron-left me-1"></i> Prev
                    </a>
                </li>
                <li class="page-item disabled">
                    <span class="page-link fw-bold text-white px-4 py-2 bg-transparent border-0">
                        Page <span style="color: var(--console-accent);">@Model.PageNumber</span>
                    </span>
                </li>
                <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                    <a class="page-link rounded-pill px-4 py-2 border-0 fw-semibold" asp-page="./Index" asp-route-PageNumber="@(Model.PageNumber + 1)" asp-route-searchQuery="@Model.SearchQuery" asp-route-category="@Model.Category" asp-route-status="@Model.Status">
                        Next <i class="bi bi-chevron-right ms-1"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
    else if (string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <!-- Empty State -->
        <div class="text-center py-5 fade-up stagger-2" style="background: var(--console-card); border: 1px solid var(--console-border); border-radius: 20px;">
            <i class="bi bi-inbox fs-1 d-block mb-3" style="color: var(--console-muted); opacity: 0.5;"></i>
            <h4 class="fw-bold text-white">No products found.</h4>
            <p class="mb-0 text-muted">Adjust your filters or add a new product to the console.</p>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteConfirmModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content rounded-4 border-0" style="backdrop-filter: blur(20px);">
      <div class="modal-header border-bottom-0 pb-0 pt-4 px-4">
        <h5 class="modal-title fw-bold text-danger" id="deleteConfirmModalLabel"><i class="bi bi-exclamation-triangle-fill me-2"></i>Confirm Deletion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body fs-5 px-4 pt-3 pb-4">
        Are you sure you want to delete <strong id="deleteProductName" class="text-white"></strong>? <br/><small class="text-muted fs-6">This action is permanent and cannot be undone.</small>
      </div>
      <div class="modal-footer border-top-0 px-4 pb-4 pt-0">
        <button type="button" class="btn btn-outline-glass rounded-pill fw-semibold px-4 py-2" data-bs-dismiss="modal">Cancel</button>
        <form method="post" asp-page-handler="DeleteProduct" id="deleteProductForm" class="m-0">
            <input type="hidden" name="productId" id="deleteProductId" value="" />
            <button type="submit" class="btn btn-outline-danger-glass rounded-pill fw-bold px-4 py-2" style="background: #ef4444; color: white;">
                Yes, Delete
            </button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(productId, productName) {
            document.getElementById('deleteProductName').innerText = productName;
            document.getElementById('deleteProductId').value = productId;
            var myModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            myModal.show();
        }
    </script>
}
