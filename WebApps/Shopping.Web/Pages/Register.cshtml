@page
@model Shopping.Web.Pages.RegisterModel
@{
    ViewData["Title"] = "Register";
}

<!-- External Fonts & Icons -->
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    /* Takwene Music Inspired Luxury Tech Theme */
    :root {
        --color-bg-canvas: #06050c;
        --color-glass: rgba(255, 255, 255, 0.03);
        --color-glass-border: rgba(255, 255, 255, 0.05);
        --color-text-main: #f8fafc;
        --color-text-muted: #94a3b8;
        --gradient-primary: linear-gradient(135deg, #8b5cf6 0%, #3b82f6 100%);
        --shadow-glow: 0 10px 40px -10px rgba(139, 92, 246, 0.3);
        --font-main: 'Plus Jakarta Sans', sans-serif;
    }

    body {
        background-color: var(--color-bg-canvas) !important;
        background-image: radial-gradient(circle at 50% 0%, rgba(139, 92, 246, 0.1) 0%, transparent 60%);
        color: var(--color-text-main) !important;
        font-family: var(--font-main) !important;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
    }

    .glass-card {
        background: var(--color-glass);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--color-glass-border);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0,0,0,0.5);
        transition: box-shadow 0.4s ease;
    }
    
    .glass-card:hover {
        box-shadow: var(--shadow-glow);
    }

    /* Form Controls */
    .form-control {
        background: rgba(255, 255, 255, 0.03) !important;
        border: 1px solid rgba(255, 255, 255, 0.1) !important;
        color: var(--color-text-main) !important;
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
        transition: all 0.3s ease;
        font-family: var(--font-main);
    }
    .form-control:focus {
        background: rgba(255, 255, 255, 0.05) !important;
        border-color: #8b5cf6 !important;
        box-shadow: 0 0 0 4px rgba(139, 92, 246, 0.15) !important;
        outline: none;
    }
    .form-control::placeholder {
        color: rgba(255, 255, 255, 0.3);
    }
    
    .form-label {
        font-weight: 600;
        letter-spacing: 0.5px;
        font-size: 0.9rem;
        color: #cbd5e1;
        margin-bottom: 0.5rem;
    }

    /* Buttons */
    .btn-gradient {
        background: var(--gradient-primary);
        color: white;
        border: none;
        border-radius: 50px;
        font-weight: 700;
        letter-spacing: 0.5px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(139, 92, 246, 0.5);
        color: white;
    }
    .btn-gradient:active {
        transform: translateY(0);
    }

    .btn-outline-glass {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: var(--color-text-main);
        border-radius: 50px;
        font-weight: 600;
        transition: all 0.3s ease;
    }
    .btn-outline-glass:hover {
        background: rgba(255, 255, 255, 0.05);
        border-color: rgba(255, 255, 255, 0.4);
        color: white;
    }

    /* Animation */
    .fade-up {
        animation: fadeUpAnim 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        opacity: 0;
        transform: translateY(20px);
    }
    @@keyframes fadeUpAnim {
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container mt-5 mb-5 fade-up">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="glass-card p-4 p-md-5">
                <div class="d-flex align-items-center mb-5 justify-content-center">
                    <div class="rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; background: rgba(139, 92, 246, 0.2); border: 1px solid rgba(139, 92, 246, 0.3);">
                        <i class="bi bi-person-plus-fill fs-4" style="color: #a78bfa;"></i>
                    </div>
                    <h2 class="fw-bolder m-0" style="letter-spacing: -0.5px;">Create an Account</h2>
                </div>
                
                @if (ModelState.IsValid == false)
                {
                    <div class="alert glass-card border-danger text-danger mb-4 d-flex align-items-center" style="background: rgba(239, 68, 68, 0.1);">
                        <i class="bi bi-exclamation-octagon-fill me-2 fs-5"></i> 
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form method="post">
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Input.FirstName" class="form-label">First Name</label>
                            <input asp-for="Input.FirstName" class="form-control" placeholder="John" required />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="Input.LastName" class="form-label">Last Name</label>
                            <input asp-for="Input.LastName" class="form-control" placeholder="Doe" required />
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Input.UserName" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #94a3b8;">@@</span>
                            <input asp-for="Input.UserName" class="form-control border-start-0 ps-0" placeholder="johndoe123" required />
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="Input.Email" class="form-label">Email Address</label>
                        <div class="input-group">
                            <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #94a3b8;"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Input.Email" class="form-control border-start-0 ps-0" type="email" placeholder="name@example.com" required />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label asp-for="Input.Password" class="form-label">Password</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #94a3b8;"><i class="bi bi-lock"></i></span>
                                <input asp-for="Input.Password" class="form-control border-start-0 ps-0" type="password" placeholder="••••••••" required />
                            </div>
                        </div>
                        <div class="col-md-6 mb-5">
                            <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                            <div class="input-group">
                                <span class="input-group-text border-0" style="background: rgba(255,255,255,0.05); color: #94a3b8;"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="Input.ConfirmPassword" class="form-control border-start-0 ps-0" type="password" placeholder="••••••••" required />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-column gap-3 pt-3 border-top" style="border-color: rgba(255,255,255,0.05) !important;">
                        <button type="submit" class="btn btn-gradient btn-lg px-5 py-3 w-100">
                            <i class="bi bi-person-plus me-2"></i> Register
                        </button>
                        <a href="/Login" class="btn btn-outline-glass btn-lg px-5 py-3 w-100 text-center text-decoration-none">Already have an account? Login here</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
