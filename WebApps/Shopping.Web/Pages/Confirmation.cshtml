@page
@model Shopping.Web.Pages.ConfirmationModel
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container my-5 text-center" style="font-family: 'Plus Jakarta Sans', sans-serif;">
    <div class="card shadow-sm border-0 mx-auto" style="border-radius: 16px; max-width: 600px;">
        <div class="card-body p-5">
            <div class="mb-4 text-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-check-circle-fill" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                </svg>
            </div>
            <h2 class="mb-3 fw-bold">Thank You!</h2>
            <p class="fs-5 text-muted mb-4">@Model.Message</p>
            <p class="text-muted mb-4">Your order is being processed and will be shipped soon. You can track your order status in your account.</p>
            
            <a asp-page="/Index" class="btn btn-primary px-5 py-3 rounded-3 fw-bold fs-5" style="background-color: #1e3a8a; border-color: #1e3a8a;">
                Continue Shopping
            </a>
        </div>
    </div>
</div>
