services:
  baket.api:
    build:
      context: E:\C#-courses\Microservices_DDD_CQRS_VerticalClean_Architecture_2024\Instashop\Instashop
      dockerfile: Services/Basket/Baket.API/Dockerfile
      args:
        BUILD_CONFIGURATION: Debug
        LAUNCHING_FROM_VS: "true"
      labels:
        com.microsoft.created-by: visual-studio
        com.microsoft.visual-studio.project-name: Baket.API
      target: base
    depends_on:
      discount.grpc:
        condition: service_started
        required: true
      postgres:
        condition: service_started
        required: true
      redis-cache:
        condition: service_started
        required: true
    entrypoint:
      - dotnet
      - --roll-forward
      - Major
      - /VSTools/DistrolessHelper/DistrolessHelper.dll
      - --wait
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ASPNETCORE_HTTP_PORTS: "8080"
      ASPNETCORE_HTTPS_PORTS: "8081"
      ASPNETCORE_LOGGING__CONSOLE__DISABLECOLORS: "true"
      ConnectionStrings__Database: Server=postgres;Database=BasketDb;User Id=postgres;Password=postgres;
      ConnectionStrings__Redis: redis-cache:6379
      DOTNET_USE_POLLING_FILE_WATCHER: "1"
      GrpcSettings__DiscountUrl: https://discount.grpc:8081
      NUGET_FALLBACK_PACKAGES: /.nuget/fallbackpackages
    image: baketapi:dev
    labels:
      com.microsoft.visualstudio.debuggee.arguments: ' --additionalProbingPath /.nuget/packages --additionalProbingPath /.nuget/fallbackpackages  "/app/bin/Debug/net10.0/Baket.API.dll"'
      com.microsoft.visualstudio.debuggee.killprogram: dotnet --roll-forward Major /VSTools/DistrolessHelper/DistrolessHelper.dll --stop dotnet
      com.microsoft.visualstudio.debuggee.program: dotnet
      com.microsoft.visualstudio.debuggee.workingdirectory: /app
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "6001"
        protocol: tcp
      - mode: ingress
        target: 8081
        published: "6061"
        protocol: tcp
